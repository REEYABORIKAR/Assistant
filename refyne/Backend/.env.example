GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Advanced RAG (Phase 4)
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_TERMS=6

DATABASE_URL=sqlite:///./data/database/refyne.db

CHROMA_PERSIST_DIRECTORY=./data/chroma

DOCUMENT_STORAGE_PATH=./data/documents

ARTIFACT_STORAGE_PATH=./data/artifacts

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:5173

# Object Storage (local or minio)
OBJECT_STORE_BACKEND=local
OBJECT_STORAGE_PATH=./data/objects
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=refyne
MINIO_SECURE=false

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Vector Store (chroma or pgvector)
VECTOR_STORE_BACKEND=chroma
